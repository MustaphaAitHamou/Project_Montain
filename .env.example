# =====================================================================
# Tamurt Alerte — variables d'environnement (modèle)
# Copier vers apps/web/.env.local (web) et apps/mobile/.env (mobile).
# Ne JAMAIS committer de vraie valeur secrète. Voir docs/deployment/environment.md
# =====================================================================

# ---------- Web (Next.js) : valeurs PUBLIQUES (exposées au navigateur) ----------
# URL du projet Supabase (local : http://127.0.0.1:54321 — voir `pnpm db:status`)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable Supabase (sb_publishable_…) ou ancienne clé « anon ». Protégée par RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL publique du site (liens de partage, redirections d'e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Style de fond de carte MapLibre (vecteur). Fournisseur autorisant l'usage commercial requis.
# Ex. OpenFreeMap (sans clé, attribution OSM) : https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=
# Origines supplémentaires des tuiles/glyphes/sprites (séparées par des virgules) pour la CSP.
# Ex. pour OpenFreeMap : https://tiles.openfreemap.org
NEXT_PUBLIC_MAP_EXTRA_ORIGINS=
# Couche satellite : laisser vide tant qu'aucun fournisseur sous licence n'est configuré.
NEXT_PUBLIC_SATELLITE_TILES_URL=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
# Clé publique VAPID pour les notifications du navigateur (générée avec `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Mode démonstration (affiche les données DÉMO clairement identifiées). Jamais en production.
NEXT_PUBLIC_DEMO_MODE=false

# ---------- Web (Next.js) : valeurs SERVEUR (secrètes) ----------
# Clé secrète Supabase (sb_secret_…) ou ancienne clé service_role. Contourne la RLS :
# uniquement côté serveur (routes API, tâches planifiées).
SUPABASE_SECRET_KEY=
# Secret partagé pour appeler les routes /api/cron/* (Authorization: Bearer …)
CRON_SECRET=
# NASA FIRMS — clé MAP_KEY gratuite : https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
# Open-Meteo — clé de l'offre commerciale (laisser vide = API gratuite, usage non commercial seulement)
OPEN_METEO_API_KEY=
# Notifications du navigateur (Web Push)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.org
# Jeton d'accès Expo (si la sécurité renforcée des push est activée dans le projet EAS)
EXPO_ACCESS_TOKEN=
# Exiger le MFA (TOTP) pour l'administration. Par défaut : true en production.
REQUIRE_ADMIN_MFA=

# ---------- Mobile (Expo) : valeurs PUBLIQUES uniquement ----------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_DEMO_MODE=false
# Identifiant du projet EAS (requis pour obtenir un jeton push Expo)
EAS_PROJECT_ID=
